let currentStage = 0;
let firstTryCorrect = 0;
let attemptedCurrent = false;
function startLab() {
const intro = document.getElementById('intro-screen');
const lab = document.getElementById('lab-screen');
intro.classList.add('zoom-in');
setTimeout(() => {
intro.style.display = 'none';
lab.style.display = 'flex';
renderStage();
}, 650);
}
function renderStage() {
const stage = stages[currentStage];
attemptedCurrent = false;
document.getElementById('step-counter').textContent = Этап ${currentStage + 1} из ${stages.length};
const dots = document.querySelectorAll('.dot');
dots.forEach((dot, idx) => {
dot.className = 'dot';
if (idx < currentStage) dot.classList.add('done');
if (idx === currentStage) dot.classList.add('active');
});
document.getElementById('cell-svg').innerHTML = stage.svg;
document.getElementById('stage-hint').textContent = stage.hint;
document.getElementById('question-text').textContent = stage.question;
const feedback = document.getElementById('feedback-box');
feedback.className = 'feedback-box';
feedback.textContent = '';
document.getElementById('next-btn').style.display = 'none';
const answerArea = document.getElementById('answer-area');
answerArea.innerHTML = '';
if (stage.type === 'choice') {
const grid = document.createElement('div');
grid.className = 'options-grid';
stage.options.forEach((optText, index) => {
const btn = document.createElement('button');
btn.className = 'option-btn';
btn.textContent = optText;
btn.onclick = () => checkChoice(index, btn);
grid.appendChild(btn);
});
answerArea.appendChild(grid);
} else if (stage.type === 'input') {
const group = document.createElement('div');
group.className = 'input-group';
const input = document.createElement('input');
input.type = 'text';
input.className = 'text-answer';
input.id = 'user-text-input';
input.placeholder = stage.placeholder;
input.addEventListener('keypress', (e) => {
if (e.key === 'Enter') checkInput();
});
const submitBtn = document.createElement('button');
submitBtn.className = 'submit-input-btn';
submitBtn.textContent = 'ОК';
submitBtn.onclick = checkInput;
group.appendChild(input);
group.appendChild(submitBtn);
answerArea.appendChild(group);
}
}
function checkChoice(selectedIndex, btnElement) {
const stage = stages[currentStage];
const feedback = document.getElementById('feedback-box');
const allBtns = document.querySelectorAll('.option-btn');
if (selectedIndex === stage.correctIndex) {
if (!attemptedCurrent) firstTryCorrect++;
btnElement.classList.add('correct');
allBtns.forEach(b => b.disabled = true);
feedback.className = 'feedback-box success';
feedback.textContent = stage.explanation;
document.getElementById('next-btn').style.display = 'block';
} else {
attemptedCurrent = true;
btnElement.classList.add('wrong');
btnElement.disabled = true;
feedback.className = 'feedback-box error';
feedback.textContent = "Не совсем так. Присмотрись внимательнее к структурам в окуляре и попробуй выбрать другой вариант!";
}
}
function checkInput() {
const stage = stages[currentStage];
const inputEl = document.getElementById('user-text-input');
const feedback = document.getElementById('feedback-box');
const userVal = inputEl.value.trim().toLowerCase().replace(/ё/g, 'е');
if (!userVal) return;
if (stage.acceptedAnswers.includes(userVal)) {
if (!attemptedCurrent) firstTryCorrect++;
inputEl.disabled = true;
inputEl.style.borderColor = 'var(--success)';
feedback.className = 'feedback-box success';
feedback.textContent = stage.explanation;
document.getElementById('next-btn').style.display = 'block';
} else {
attemptedCurrent = true;
inputEl.style.borderColor = 'var(--error)';
feedback.className = 'feedback-box error';
feedback.textContent = "Ошибка в термине или формуле. Проверь раскладку (для формулы нужны латинские буквы n и c) и попробуй ещё раз!";
}
}
function nextStage() {
currentStage++;
if (currentStage < stages.length) {
renderStage();
} else {
showResults();
}
}
function showResults() {
document.getElementById('lab-screen').style.display = 'none';
const resultScreen = document.getElementById('result-screen');
resultScreen.style.display = 'flex';
document.getElementById('final-score').textContent = ${firstTryCorrect}/${stages.length};
const comment = document.getElementById('result-comment');
if (firstTryCorrect === stages.length) {
comment.textContent = "Блестяще! Ты безошибочно определил все фазы митоза. Покажи этот экран учителю (оценка «5»).";
} else if (firstTryCorrect >= 3) {
comment.textContent = "Хороший результат! Все этапы пройдены. Покажи этот экран учителю.";
} else {
comment.textContent = "Ты дошёл до конца, но были ошибки. Можешь пройти практикум ещё раз, чтобы закрепить фазы!";
}
}



